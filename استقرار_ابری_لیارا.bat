@echo off
chcp 65001 >nul
title استقرار ابری هوش مصنوعی سپهریار (Liara Deploy)
color 0A

echo ===================================================================
echo     🚀 استقرار ۲۴ ساعته هوش مصنوعی سپهریار روی ابر (Liara Cloud)
echo ===================================================================
echo.
echo این اسکریپت برنامه هوش مصنوعی را به سرورهای ابری منتقل می‌کند
echo تا حتی در زمان خاموش بودن کامپیوتر شخصی شما، ۲۴ ساعته آنلاین باشد.
echo.
echo مراحل استقرار:
echo ۱. ورود به حساب کاربری لیارا
echo ۲. آپلود کدهای پروژه و دیتابیس هوش مصنوعی
echo ۳. اتصال خودکار به دامنه
echo ===================================================================
echo.

cd /d "D:\ai app"

where liara >nul 2>nul
if %errorlevel% neq 0 (
    echo [اطلاع] ابزار Liara CLI نصب نیست. در حال نصب خودکار...
    npm install -g @liara/cli
)

echo.
echo [۱] ورود به لیارا (در صورت نیاز پنجره مرورگر باز می‌شود):
call liara login

echo.
echo [۲] در حال استقرار و بارگذاری روی سرور ابری...
call liara deploy

echo.
echo ===================================================================
echo ✅ استقرار با موفقیت انجام شد!
echo هوش مصنوعی اکنون ۲۴ ساعته در اینترنت فعال است.
echo ===================================================================
pause
