<Window x:Class="SepehryarWPF.SpotlightWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="نوار هوشمند سپهریار"
        Width="780" MinHeight="100" MaxHeight="680"
        SizeToContent="Height"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        WindowStartupLocation="Manual"
        FlowDirection="RightToLeft"
        PreviewKeyDown="Window_PreviewKeyDown">

    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml" />
    </Window.Resources>

    <!-- Outer Container with Drop Shadow & Glow Border -->
    <Border Margin="16" Style="{StaticResource GlowCard}">
        <Grid Margin="18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" /> <!-- Header Controls -->
                <RowDefinition Height="Auto" /> <!-- Search Box -->
                <RowDefinition Height="Auto" /> <!-- Quick Chips -->
                <RowDefinition Height="Auto" /> <!-- Loading Bar -->
                <RowDefinition Height="*" />    <!-- Answer Container -->
            </Grid.RowDefinitions>

            <!-- 1. Header Row (Draggable) -->
            <Grid Grid.Row="0" Margin="0,0,0,12" Background="Transparent" MouseLeftButtonDown="Header_MouseLeftButtonDown" Cursor="SizeAll">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="🧠" FontSize="18" Margin="0,0,8,0" VerticalAlignment="Center" />
                    <TextBlock Text="دستیار و معمار هوشمند سپهریار" 
                               FontFamily="{StaticResource MainFont}" 
                               FontWeight="Bold" FontSize="14" 
                               Foreground="{StaticResource BrushCyan}" 
                               VerticalAlignment="Center" />
                    <Border Background="#2000E5FF" CornerRadius="4" Padding="6,2" Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Ctrl + Space" FontSize="10" Foreground="{StaticResource BrushCyan}" />
                    </Border>
                </StackPanel>

                <!-- Window Actions -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Cursor="Arrow">
                    <Button x:Name="BtnToggleChips" Content="⚡ میانبرها ▾" Style="{StaticResource OutlineBtn}" Padding="8,4" Margin="0,0,6,0" Click="BtnToggleChips_Click" />
                    <Button x:Name="BtnPin" Content="📌 پین" Style="{StaticResource OutlineBtn}" Padding="8,4" Margin="0,0,6,0" Click="BtnPin_Click" />
                    <Button x:Name="BtnClose" Content="✕ بستن" Style="{StaticResource OutlineBtn}" Padding="8,4" Click="BtnClose_Click" />
                </StackPanel>
            </Grid>

            <!-- 2. Search Box Row -->
            <Grid Grid.Row="1" Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBox x:Name="TxtQuery" Style="{StaticResource ModernTextBox}" 
                         FontSize="14" Padding="14,10"
                         KeyDown="TxtQuery_KeyDown" />

                <!-- Placeholder Text -->
                <TextBlock x:Name="TxtPlaceholder" Text="پرسش یا دستور خود را بنویسید (مثلاً: چجوری حساب تعریف بکنم)..." 
                           Foreground="#60F0F6FC" FontSize="13"
                           FontFamily="{StaticResource MainFont}"
                           IsHitTestVisible="False"
                           Margin="16,11,0,0" />

                <Button Grid.Column="1" x:Name="BtnSubmit" Content="⏎ ارسال" 
                        Style="{StaticResource PrimaryBtn}" 
                        Margin="8,0,0,0" Click="BtnSubmit_Click" />
            </Grid>

            <!-- 3. Quick Chips Row -->
            <WrapPanel x:Name="PanelChips" Grid.Row="2" Margin="0,0,0,10">
                <Button Content="📦 راهنمای تعریف کالا" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="🏬 راهنمای تعریف انبار" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="📝 باجه ثبت سند" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="🔗 مسیر join بین شخص و فاکتور" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="📋 ستون‌های جدول TblSanad" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="💻 پروسیجر مشتریان بدهکار" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="🏦 مغایرت بانکی" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
                <Button Content="🔒 رفع خطای قفل و Deadlock" Style="{StaticResource OutlineBtn}" Margin="0,0,6,6" Click="Chip_Click" />
            </WrapPanel>

            <!-- 4. Loading Indicator -->
            <ProgressBar Grid.Row="3" x:Name="PrgLoading" Height="3" IsIndeterminate="True" 
                         Foreground="{StaticResource BrushCyan}" Background="#203040"
                         BorderThickness="0" Margin="0,0,0,10" Visibility="Collapsed" />

            <!-- 5. Rich Result Container -->
            <Border Grid.Row="4" x:Name="BorderResult" 
                    Background="#141922" BorderBrush="{StaticResource BrushBorder}" 
                    BorderThickness="1" CornerRadius="10" Padding="14" 
                    Visibility="Collapsed">
                <ScrollViewer MaxHeight="450" VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- Response Header & Timing -->
                        <Grid Margin="0,0,0,8">
                            <TextBlock x:Name="TxtResultTopic" Text="پاسخ هوش مصنوعی سپهریار" 
                                       FontFamily="{StaticResource MainFont}" 
                                       FontWeight="Bold" FontSize="13" 
                                       Foreground="{StaticResource BrushCyan}" />
                            <TextBlock x:Name="TxtTiming" HorizontalAlignment="Left" 
                                       Text="⚡ پاسخ در ۱۱۰ میلی‌ثانیه" 
                                       FontSize="11" Foreground="{StaticResource BrushTextMuted}" />
                        </Grid>

                        <!-- Response Text Content -->
                        <TextBox x:Name="TxtAnswer" 
                                 Background="Transparent" BorderThickness="0" 
                                 Foreground="{StaticResource BrushTextPrimary}" 
                                 FontFamily="{StaticResource MainFont}" FontSize="13" 
                                 TextWrapping="Wrap" IsReadOnly="True" 
                                 FlowDirection="RightToLeft"
                                 Margin="0,0,0,10" />

                        <!-- Code Block Container (if any) -->
                        <Border x:Name="BorderCode" Background="#0A0D13" 
                                BorderBrush="#4000E5FF" BorderThickness="1" 
                                CornerRadius="8" Padding="10" Margin="0,0,0,6" 
                                Visibility="Collapsed">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                
                                <DockPanel Grid.Row="0" Margin="0,0,0,6">
                                    <TextBlock Text="اسکریپت استاندارد SQL / C#" FontSize="11" Foreground="{StaticResource BrushCyan}" />
                                    <Button x:Name="BtnCopyCode" Content="📋 کپی اسکریپت" 
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource OutlineBtn}" Padding="8,3" FontSize="11"
                                            Click="BtnCopyCode_Click" />
                                </DockPanel>

                                <TextBox Grid.Row="1" x:Name="TxtCode" 
                                         Background="Transparent" BorderThickness="0" 
                                         Foreground="#A5D6FF" FontFamily="Consolas, Courier New" 
                                         FontSize="12" TextWrapping="Wrap" IsReadOnly="True" 
                                         FlowDirection="LeftToRight" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Border>
</Window>
